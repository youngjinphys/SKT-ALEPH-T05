{
  "schema_version": 1,
  "feature": "Text layer z-order controls",
  "immutable_after_ai_a_start": true,
  "tests": [
    {
      "id": "T05-F01",
      "input": "이미지를 불러오고 문구 레이어 3개를 추가한다.",
      "expected": "레이어 목록과 캔버스에 문구 레이어 3개가 존재한다."
    },
    {
      "id": "T05-F02",
      "input": "가운데 순서의 문구 레이어를 선택한다.",
      "expected": "앞으로/뒤로 컨트롤이 모두 표시되고 활성화된다."
    },
    {
      "id": "T05-F03",
      "input": "가운데 레이어에서 '앞으로'를 1회 실행한다.",
      "expected": "선택 레이어가 정확히 한 단계 위로 이동한다."
    },
    {
      "id": "T05-F04",
      "input": "최상위 레이어를 선택한다.",
      "expected": "'앞으로' 컨트롤이 비활성화되고 순서는 바뀌지 않는다."
    },
    {
      "id": "T05-F05",
      "input": "가운데 레이어에서 '뒤로'를 1회 실행한다.",
      "expected": "선택 레이어가 정확히 한 단계 아래로 이동한다."
    },
    {
      "id": "T05-F06",
      "input": "최하위 레이어를 선택한다.",
      "expected": "'뒤로' 컨트롤이 비활성화되고 순서는 바뀌지 않는다."
    },
    {
      "id": "T05-F07",
      "input": "레이어 순서를 변경한다.",
      "expected": "순서 변경 뒤에도 같은 레이어가 선택 상태로 유지된다."
    },
    {
      "id": "T05-F08",
      "input": "레이어 순서를 변경한 직후 Undo를 1회 실행한다.",
      "expected": "변경 직전의 겹침 순서로 정확히 복원된다."
    },
    {
      "id": "T05-F09",
      "input": "T05-F08 직후 Redo를 1회 실행한다.",
      "expected": "Undo 전의 변경된 겹침 순서가 다시 복원된다."
    },
    {
      "id": "T05-F10",
      "input": "동일 위치에 겹친 서로 다른 색상의 레이어 순서를 변경한 뒤 미리보기와 PNG 내보내기를 확인한다.",
      "expected": "미리보기와 실제 PNG 출력이 동일한 최상위 레이어를 표시한다."
    }
  ]
}
